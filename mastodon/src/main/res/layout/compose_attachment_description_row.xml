<?xml version="1.0" encoding="utf-8"?>
<!-- MAMMUT: The Caption Track (docs/CAPTION-TRACK-SPEC.md §3) — one inline description
	 row per image attachment, built programmatically by ComposeMediaViewController
	 beneath the media strip. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="horizontal"
	android:gravity="top"
	android:paddingVertical="8dp">

	<ImageView
		android:id="@+id/thumb"
		android:layout_width="32dp"
		android:layout_height="32dp"
		android:layout_marginTop="4dp"
		android:layout_marginEnd="12dp"
		android:scaleType="centerCrop"
		android:importantForAccessibility="no"
		tools:src="#0f0"/>

	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:orientation="vertical">

		<TextView
			android:id="@+id/label"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textAppearance="@style/m3_label_medium"
			android:textColor="?colorM3OnSurfaceVariant"
			tools:text="Image 1"/>

		<EditText
			android:id="@+id/edit"
			android:layout_width="match_parent"
			android:saveEnabled="false"
			android:layout_height="wrap_content"
			android:minLines="2"
			android:maxLines="4"
			android:gravity="top"
			android:hint="@string/image_description_hint"
			android:textColorHint="?colorM3OnSurfaceVariant"
			android:inputType="textMultiLine|textCapSentences"
			android:textAppearance="@style/m3_body_large"
			android:textColor="?colorM3OnSurface"
			android:background="@null"
			android:padding="0dp"
			android:scrollbars="vertical"/>

		<TextView
			android:id="@+id/helper"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textAppearance="@style/m3_body_small"
			android:textColor="?colorM3OnSurfaceVariant"
			android:accessibilityLiveRegion="polite"
			tools:text="Describe what matters in this image."/>

	</LinearLayout>
</LinearLayout>
