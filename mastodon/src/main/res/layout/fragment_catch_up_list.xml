<?xml version="1.0" encoding="utf-8"?>
<!-- MAMMUT: Catch up — list content. Mirrors the appkit recycler layout but swaps
	 the themed empty stub for the Catch up empty view, which needs a supporting
	 line and a secondary action (spec §7). No swipe-refresh: reopening is the
	 refresh (spec §3). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/content_wrap"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<me.grishka.appkit.views.UsableRecyclerView
		android:id="@+id/list"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:scrollbars="vertical"
		android:clipToPadding="false" />

	<include
		android:id="@+id/empty"
		layout="@layout/catch_up_empty" />
</FrameLayout>
