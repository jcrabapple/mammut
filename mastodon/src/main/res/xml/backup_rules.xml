<?xml version="1.0" encoding="utf-8"?>
<!-- MAMMUT: cloud/device backup is disabled (android:allowBackup="false"); settings transfer
     uses explicit Settings Export. These exclusions remain as defense-in-depth so no
     databases, credentials, push keys, or drafts ever leave the device via backup. -->
<full-backup-content>
	<exclude domain="database" path="."/>
	<exclude domain="database" path="accounts.db"/>
	<exclude domain="sharedpref" path="."/>
	<exclude domain="sharedpref" path="account_manager.xml"/>
	<exclude domain="file" path="."/>
</full-backup-content>
