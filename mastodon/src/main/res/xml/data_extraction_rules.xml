<?xml version="1.0" encoding="utf-8"?>
<!-- MAMMUT: API 31+ defense-in-depth backup/transfer rules (android:allowBackup="false";
     settings transfer uses explicit Settings Export). Excludes all databases, preferences,
     push keystores, and files from cloud backup and device transfer. -->
<data-extraction-rules>
	<cloud-backup>
		<exclude domain="database" path="."/>
		<exclude domain="database" path="accounts.db"/>
		<exclude domain="sharedpref" path="."/>
		<exclude domain="sharedpref" path="account_manager.xml"/>
		<exclude domain="file" path="."/>
	</cloud-backup>
	<device-transfer>
		<exclude domain="database" path="."/>
		<exclude domain="database" path="accounts.db"/>
		<exclude domain="sharedpref" path="."/>
		<exclude domain="sharedpref" path="account_manager.xml"/>
		<exclude domain="file" path="."/>
	</device-transfer>
</data-extraction-rules>
